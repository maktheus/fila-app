<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F0EFEB</item>
        <item name="android:navigationBarColor">#F0EFEB</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#ED2C27</item>
    </style>

    <!--
      Tema so do arranque. A activity troca para AppTheme no onCreate, antes
      de desenhar qualquer coisa: sem essa troca, o windowBackground da
      splash ficaria atras do WebView a vida inteira.

      Android 11 e anteriores: a splash e este windowBackground.
      Android 12+: os atributos de values-v31 assumem.
    -->
    <style name="AppTheme.Splash" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
