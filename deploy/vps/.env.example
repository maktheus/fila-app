NODE_ENV=production
APP_VERSION=1.0.0
POSTGRES_DB=fila
POSTGRES_USER=fila
POSTGRES_PASSWORD=replace-with-a-strong-db-password
CORS_ORIGIN=https://maktheus.github.io
# Credencial de automacao (scripts, monitoramento)
ADMIN_TOKEN=replace-with-a-random-secret
# Senha que o operador digita no painel; a sessao expira em SESSION_TTL_HOURS
OPERATOR_PASSWORD=replace-with-the-counter-password
SESSION_TTL_HOURS=8
# LGPD: tickets encerrados sao apagados apos esta janela
TICKET_RETENTION_HOURS=12
SEED_DEMO=false
VENUE_NAME=Clinica Centro
OPERATOR_NAME=Equipe balcao
VENUE_SLUG=centro
VENUE_QR_TOKEN=demo-centro
VENUE_LAT=-3.119028
VENUE_LNG=-60.021731
PROXIMITY_RADIUS_METERS=120
PLAN=free
ADS_ENABLED=true

# --- Chatbot de vendas ---
# local  = modelo rodando na propria VPS, custo zero (padrao)
# claude = API da Anthropic, melhor conversa, custo por token
CHAT_PROVIDER=local

# Endpoint compativel com OpenAI. Ollama, llama.cpp, LM Studio e vLLM servem
# todos em /v1/chat/completions. Rodando o Ollama na propria VPS:
#   ollama pull qwen2.5:7b
# Se o Ollama estiver no host e o backend em container, use
# http://host.docker.internal:11434/v1 (o compose ja faz isso).
LOCAL_LLM_BASE=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
# Em CPU sem GPU uma resposta leva de 3 a 20 segundos — daí o teto alto
LOCAL_LLM_TIMEOUT_MS=90000
LOCAL_LLM_TEMPERATURE=0.3
# So se o runtime exigir (LM Studio, vLLM). Ollama ignora.
LOCAL_LLM_API_KEY=

# So usados com CHAT_PROVIDER=claude
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5
CHAT_EFFORT=low

CHAT_MAX_DEMOS_HORA=10
RATE_LIMIT_CHAT=12

# --- Assinatura ---
# URL publica do app: e o que o QR code aponta e a base do checkout
PUBLIC_APP_URL=https://maktheus.github.io/fila-app
TRIAL_DAYS=14
PLAN_PRICE_CENTS=9900
# sandbox = simula o pagamento localmente; troque por cakto/mercadopago com a conta pronta
# sandbox = cobranca de mentira, para testar a jornada inteira sem conta
# mercadopago = cobranca Pix de verdade pela Orders API
PAYMENT_PROVIDER=sandbox
CHECKOUT_BASE_URL=
# OBRIGATORIO em producao com provedor generico (Cakto): sem ele o webhook e recusado
PAYMENT_WEBHOOK_SECRET=replace-with-the-provider-webhook-secret

# --- Mercado Pago (so com PAYMENT_PROVIDER=mercadopago) ---
# Credenciais > Access Token de producao. NUNCA commitar.
MP_ACCESS_TOKEN=
# Webhooks > Configurar notificacao: o MP mostra a "chave secreta" ali.
# E diferente do PAYMENT_WEBHOOK_SECRET acima — o MP assina um manifesto
# remontado (id + request-id + ts), nao o corpo cru.
# Webhook a cadastrar no painel: https://SEU-DOMINIO/api/webhooks/mercadopago
# Topicos: "orders" e "payment".
MP_WEBHOOK_SECRET=
# Validade do Pix. Faixa aceita pelo MP: 30 a 43200 minutos (30 dias).
MP_PIX_EXPIRA_MINUTOS=1440
# Cobrancas por hora por IP
RATE_LIMIT_COBRANCA=10

# --- E-mail transacional (opcional) ---
MAIL_ENABLED=false
MAIL_FROM=Fila Virtual <nao-responda@seu-dominio.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
